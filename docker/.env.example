# Copy to docker/.env (git-ignored) before running `docker compose up`.
# Local development values only.

# MariaDB root password. It must match the password already stored in the data
# directory when the database was seeded from an existing install.
MYSQL_ROOT_PASSWORD=123

# Frappe site served on localhost:8000.
SITE_NAME=lms.localhost

# Set to 1 to run `bench --site $SITE_NAME migrate` once at container start.
RUN_MIGRATE=0
